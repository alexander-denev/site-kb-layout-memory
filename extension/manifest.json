{
  "manifest_version": 3,
  "name": "Site Layout Memory",
  "version": "2.0.0",
  "description": "Each website remembers its own Windows keyboard layout, even after a restart.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Site Layout Memory",
    "default_popup": "popup.html"
  }
}