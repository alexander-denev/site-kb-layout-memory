{
  "manifest_version": 3,
  "name": "Tab Layout Memory",
  "version": "1.0.0",
  "description": "Remembers your Windows keyboard layout separately for each tab, like Windows does for each app window.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Tab Layout Memory \u2014 click for settings"
  }
}